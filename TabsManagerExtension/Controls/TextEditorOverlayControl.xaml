<helpers:BaseUserControl x:Class="TabsManagerExtension.Controls.TextEditorOverlayControl"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:local="clr-namespace:TabsManagerExtension"
                         xmlns:localEnums="clr-namespace:TabsManagerExtension.Enums"
                         xmlns:localControls="clr-namespace:TabsManagerExtension.Controls"
                         xmlns:localConverters="clr-namespace:TabsManagerExtension.Converters"
                         xmlns:localBehaviours="clr-namespace:TabsManagerExtension.Behaviours"
                         xmlns:localStateDocument="clr-namespace:TabsManagerExtension.State.Document"
                         xmlns:helpers="clr-namespace:Helpers"
                         x:Name="__TextEditorOverlayControl"
                         VerticalAlignment="Top"
                         HorizontalAlignment="Left"
                         >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/BrushResources.xaml"/>
                <ResourceDictionary Source="../Styles/IconResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="AnchorContainerStyle" TargetType="Grid">
                <Setter Property="Width" Value="auto"/>
                <Setter Property="Margin" Value="0,30,30,0"/>
                <!-- Весь блок якорей закреплён у правого верхнего края редактора. -->
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>


            <Style x:Key="AnchorToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Width" Value="45"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#999999"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <!-- Кнопка остаётся справа даже когда раскрытый список расширяет контейнер. -->
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="ToolTip" Value="Show anchors"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid Width="28"
                                      Height="28"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Path x:Name="AnchorOutlineNormalGlyph"
                                          Style="{StaticResource Icons/AnchorOutlineStyle}"
                                          Stroke="{TemplateBinding Foreground}"
                                          Fill="{TemplateBinding Foreground}" />
                                    <Path x:Name="AnchorOutlineActiveGlyph"
                                          Style="{StaticResource Icons/AnchorOutlineStyle}"
                                          Data="{DynamicResource Icons/AnchorOutlineActiveGeometry}"
                                          Stroke="{TemplateBinding Foreground}"
                                          Fill="{TemplateBinding Foreground}"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AppIsMouseOverBrush}"/>
                                    <Setter Property="Foreground" Value="#D4D4D4"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AppIsMouseOverBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter TargetName="AnchorOutlineNormalGlyph"
                                            Property="Visibility"
                                            Value="Collapsed"/>
                                    <Setter TargetName="AnchorOutlineActiveGlyph"
                                            Property="Visibility"
                                            Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Команды Quick Find выглядят частью штатной панели и получают фон только при наведении. -->
            <Style x:Key="FindCommandButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,2,0"/>
                <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#999999"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AppIsMouseOverBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#505050"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>



            <Style x:Key="AnchorListBoxStyle" TargetType="ListBox">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="AnchorListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="IsEnabled" Value="True"/>
                <Setter Property="Focusable" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" 
                                    Background="Transparent"
                                    >
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="4,0"
                                                  />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppIsMouseOverBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppIsMouseOverBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding AnchorKind}" Value="{x:Static localEnums:AnchorKind.Separator}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Focusable" Value="False"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>


    <Grid>
        <!-- Панель показывается только пока открыта штатная Quick Find. -->
        <Border x:Name="FindCommandsContainer"
                Margin="0,0,30,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource FindCommandButtonStyle}"
                        Command="{Binding OnFindNextCommand}"
                        Content="↓"
                        ToolTip="Find next (F3)" />
                <Button Style="{StaticResource FindCommandButtonStyle}"
                        Command="{Binding OnFindPreviousCommand}"
                        Content="↑"
                        ToolTip="Find previous (Shift+F3)" />
                <Button Style="{StaticResource FindCommandButtonStyle}"
                        Command="{Binding OnFindInSolutionCommand}"
                        FontSize="13"
                        Margin="0"
                        Content="⌕S"
                        ToolTip="Find in solution" />
            </StackPanel>
        </Border>

        <Grid x:Name="AnchorContainer"
              Style="{StaticResource AnchorContainerStyle}">
            <Border BorderThickness="1"
                    BorderBrush="#00ffffff"
                    >
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Высота первой строки определяется фактическими размерами кнопки. -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ToggleButton Grid.Row="0"
                                  Style="{StaticResource AnchorToggleButtonStyle}"
                                  Command="{Binding OnToggleAnchorListCommand}"
                                  IsChecked="{Binding IsAnchorListVisible.Value, Mode=OneWay}"
                                  Visibility="{Binding IsAnchorToggleButtonVisible.Visibility}"
                                  />
                    <Border Grid.Row="1"
                            Background="White"
                            Visibility="{Binding IsAnchorListVisible.Visibility}"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Margin="0,5,0,0"
                            >
                        <ListBox x:Name="AnchorListBox"
                                 Style="{StaticResource AnchorListBoxStyle}"
                                 ItemContainerStyle="{StaticResource AnchorListBoxItemStyle}"
                                 ItemsSource="{Binding Anchors}"   
                                 SelectedItem="{Binding SelectedAnchor, Mode=TwoWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 >
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- Text -->
                                        <TextBlock Text="{Binding Title}"
                                                   FontFamily="Consolas"
                                                   FontSize="13"
                                                   >
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AnchorKind}" Value="{x:Static localEnums:AnchorKind.Section}">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Padding" Value="5,5,5,5"/>
                                                            <Setter Property="Margin" Value="0,2,0,2"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding AnchorKind}" Value="{x:Static localEnums:AnchorKind.Subsection}">
                                                            <Setter Property="Foreground" Value="#CCCCCC"/>
                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                            <Setter Property="Padding" Value="5,5,5,5"/>
                                                            <Setter Property="Margin" Value="12,2,0,2"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding AnchorKind}" Value="{x:Static localEnums:AnchorKind.Separator}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Separator -->
                                        <Rectangle Height="1"
                                                    Fill="#444"
                                                    Margin="0,6,0,6"
                                                    >
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AnchorKind}" Value="{x:Static localEnums:AnchorKind.Separator}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</helpers:BaseUserControl>
