<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="TabsManagerExtension.Controls.TabsManagerSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
             FontFamily="Segoe UI"
             FontSize="13">
    <UserControl.Resources>
        <!-- Общие стили удерживают все секции собственной страницы в единой теме Visual Studio. -->
        <Style x:Key="SectionHeaderStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="20" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
        <Style x:Key="SubsectionHeaderStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource SectionHeaderStyle}">
            <Setter Property="FontSize"
                    Value="18" />
        </Style>
        <Style x:Key="SettingLabelStyle"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="18,0,18,0" />
            <Setter Property="FontSize"
                    Value="14" />
        </Style>
        <Style x:Key="EditorStyle"
               TargetType="Control">
            <Setter Property="Height"
                    Value="28" />
            <Setter Property="Margin"
                    Value="0,4" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
            <Setter Property="Background"
                    Value="#FF2D2D30" />
            <Setter Property="BorderBrush"
                    Value="#FF454545" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <EventSetter Event="KeyDown"
                         Handler="OnEditorKeyDown" />
        </Style>
        <Style x:Key="FontOptionCheckBoxStyle"
               TargetType="CheckBox"
               BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.ThemedDialogCheckBoxStyleKey}}">
            <Setter Property="Margin"
                    Value="8,4,0,4" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="FontFamily"
                    Value="Segoe UI" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
        </Style>
        <Style x:Key="SettingsButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}">
            <Setter Property="MinWidth"
                    Value="128" />
            <Setter Property="Height"
                    Value="28" />
            <Setter Property="Padding"
                    Value="12,3" />
            <Setter Property="FontFamily"
                    Value="Segoe UI" />
            <Setter Property="FontSize"
                    Value="13" />
        </Style>
        <Style x:Key="NavigationButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="36" />
            <Setter Property="Margin"
                    Value="0,0,0,2" />
            <Setter Property="Padding"
                    Value="16,0" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Left" />
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Background"
                                        Property="Background"
                                        Value="#FF333337" />
                            </Trigger>
                            <Trigger Property="Tag"
                                     Value="Selected">
                                <Setter TargetName="Background"
                                        Property="Background"
                                        Value="#FF37373D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- Левая панель переключает содержимое, не создавая отдельные экземпляры страницы настроек. -->
        <Border Grid.Column="0"
                BorderBrush="#FF3F3F46"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="12,28,12,0">
                <TextBlock Margin="12,0,0,14"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="Tabs Manager" />
                <Button x:Name="MainNavigationButton"
                        Style="{StaticResource NavigationButtonStyle}"
                        Click="OnMainNavigationClicked"
                        Content="Main"
                        Tag="Selected" />
                <Button x:Name="CustomizationNavigationButton"
                        Style="{StaticResource NavigationButtonStyle}"
                        Click="OnCustomizationNavigationClicked"
                        Content="Customization" />
                <Button x:Name="AnchorsNavigationButton"
                        Style="{StaticResource NavigationButtonStyle}"
                        Click="OnAnchorsNavigationClicked"
                        Content="Comment anchors" />
            </StackPanel>
        </Border>
        <!-- Секции остаются в визуальном дереве; code-behind показывает только выбранную секцию. -->
        <ScrollViewer x:Name="MainPanel"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="52,28,52,44"
                  MaxWidth="720"
                  HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="2"
                           Margin="0,0,0,26"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="All Settings &gt; Tabs Manager &gt; Main" />
                <Grid Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}"
                               Text="General" />
                    <Border Grid.Column="1"
                            Height="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Background="#FF4A4A4A" />
                </Grid>
                <TextBlock Grid.Row="2"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Load tabs on startup" />
                <CheckBox x:Name="AutoLoadTabsCheckBox"
                          Grid.Row="2"
                          Grid.Column="1"
                          Style="{StaticResource FontOptionCheckBoxStyle}"
                          Checked="OnAutoLoadTabsChanged"
                          Unchecked="OnAutoLoadTabsChanged" />
            </Grid>
        </ScrollViewer>
        <!-- Шаблоны якорей редактируются как многострочные регулярные выражения. -->
        <ScrollViewer x:Name="AnchorsPanel"
                      Grid.Column="1"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="52,28,52,44"
                  MaxWidth="720"
                  HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="2"
                           Margin="0,0,0,26"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="All Settings &gt; Tabs Manager &gt; Comment anchors" />
                <Grid Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}"
                               Text="Overlay and anchor list" />
                    <Border Grid.Column="1"
                            Height="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Background="#FF4A4A4A" />
                </Grid>
                <TextBlock Grid.Row="2"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Section pattern" />
                <TextBox x:Name="AnchorSectionPatternText"
                         Grid.Row="2"
                         Grid.Column="1"
                         MinHeight="64"
                         Margin="0,4"
                         Padding="6,4"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Style="{StaticResource EditorStyle}"
                         Height="Auto"
                         LostKeyboardFocus="OnAnchorPatternCommitted"
                         Tag="section" />
                <TextBlock Grid.Row="3"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Subsection pattern" />
                <TextBox x:Name="AnchorSubsectionPatternText"
                         Grid.Row="3"
                         Grid.Column="1"
                         MinHeight="64"
                         Margin="0,4"
                         Padding="6,4"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Style="{StaticResource EditorStyle}"
                         Height="Auto"
                         LostKeyboardFocus="OnAnchorPatternCommitted"
                         Tag="subsection" />
            </Grid>
        </ScrollViewer>
        <!-- Кастомизация напрямую изменяет ресурсы панели вкладок через сервис настроек. -->
        <ScrollViewer x:Name="CustomizationPanel"
                      Grid.Column="1"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="52,28,52,44"
                  MaxWidth="720"
                  HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Grid.ColumnSpan="2"
                      Margin="0,0,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="All Settings &gt; Tabs Manager &gt; Customization" />
                    <Button Grid.Column="1"
                            Margin="18,0,0,0"
                            Style="{StaticResource SettingsButtonStyle}"
                            Click="OnResetSettingsClicked"
                            Content="Reset to defaults" />
                </Grid>
                <Grid Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}"
                               Text="Tabs panel" />
                    <Border Grid.Column="1"
                            Height="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Background="#FF4A4A4A" />
                </Grid>
                <TextBlock Grid.Row="2"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Background" />
                <Grid Grid.Row="2"
                      Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PanelBackgroundSwatch"
                            Margin="0,4,4,4"
                            BorderBrush="#777"
                            BorderThickness="1"
                            MouseLeftButtonDown="OnColorSwatchClicked"
                            Tag="PanelBackgroundText" />
                    <TextBox x:Name="PanelBackgroundText"
                             Grid.Column="1"
                             Style="{StaticResource EditorStyle}"
                             LostKeyboardFocus="OnColorTextCommitted"
                             Tag="panelBackgroundColor" />
                </Grid>
                <Grid Grid.Row="3"
                      Grid.ColumnSpan="2"
                      Margin="0,22,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}"
                               Text="Tab states" />
                    <Border Grid.Column="1"
                            Height="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Background="#FF4A4A4A" />
                </Grid>
                <Grid Grid.Row="4"
                      Grid.ColumnSpan="2"
                      Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SubsectionHeaderStyle}"
                               Text="Background and border" />
                    <Border Grid.Column="1"
                            Height="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Background="#FF4A4A4A" />
                </Grid>
                <TextBlock Grid.Row="5"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Normal    Background" />
                <Grid Grid.Row="5"
                      Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TabBackgroundSwatch"
                            Margin="0,4,4,4"
                            BorderBrush="#777"
                            BorderThickness="1"
                            MouseLeftButtonDown="OnColorSwatchClicked"
                            Tag="TabBackgroundText" />
                    <TextBox x:Name="TabBackgroundText"
                             Grid.Column="1"
                             Style="{StaticResource EditorStyle}"
                             LostKeyboardFocus="OnColorTextCommitted"
                             Tag="tabBackgroundColor" />
                </Grid>
                <TextBlock Grid.Row="6"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Normal    Border" />
                <Grid Grid.Row="6"
                      Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TabBorderSwatch"
                            Margin="0,4,4,4"
                            BorderBrush="#777"
                            BorderThickness="1"
                            MouseLeftButtonDown="OnColorSwatchClicked"
                            Tag="TabBorderText" />
                    <TextBox x:Name="TabBorderText"
                             Grid.Column="1"
                             Style="{StaticResource EditorStyle}"
                             LostKeyboardFocus="OnColorTextCommitted"
                             Tag="tabBorderColor" />
                </Grid>
                <TextBlock Grid.Row="7"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Hovered   Background" />
                <Grid Grid.Row="7"
                      Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TabHoverBackgroundSwatch"
                            Margin="0,4,4,4"
                            BorderBrush="#777"
                            BorderThickness="1"
                            MouseLeftButtonDown="OnColorSwatchClicked"
                            Tag="TabHoverBackgroundText" />
                    <TextBox x:Name="TabHoverBackgroundText"
                             Grid.Column="1"
                             Style="{StaticResource EditorStyle}"
                             LostKeyboardFocus="OnColorTextCommitted"
                             Tag="tabHoverBackgroundColor" />
                </Grid>
                <TextBlock Grid.Row="8"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Hovered   Border" />
                <Grid Grid.Row="8"
                      Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TabHoverBorderSwatch"
                            Margin="0,4,4,4"
                            BorderBrush="#777"
                            BorderThickness="1"
                            MouseLeftButtonDown="OnColorSwatchClicked"
                            Tag="TabHoverBorderText" />
                    <TextBox x:Name="TabHoverBorderText"
                             Grid.Column="1"
                             Style="{StaticResource EditorStyle}"
                             LostKeyboardFocus="OnColorTextCommitted"
                             Tag="tabHoverBorderColor" />
                </Grid>
                <TextBlock Grid.Row="9"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Selected  Background" />
                <Grid Grid.Row="9"
                      Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SelectedTabBackgroundSwatch"
                            Margin="0,4,4,4"
                            BorderBrush="#777"
                            BorderThickness="1"
                            MouseLeftButtonDown="OnColorSwatchClicked"
                            Tag="SelectedTabBackgroundText" />
                    <TextBox x:Name="SelectedTabBackgroundText"
                             Grid.Column="1"
                             Style="{StaticResource EditorStyle}"
                             LostKeyboardFocus="OnColorTextCommitted"
                             Tag="selectedTabBackgroundColor" />
                </Grid>
                <TextBlock Grid.Row="10"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Selected  Border" />
                <Grid Grid.Row="10"
                      Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SelectedTabBorderSwatch"
                            Margin="0,4,4,4"
                            BorderBrush="#777"
                            BorderThickness="1"
                            MouseLeftButtonDown="OnColorSwatchClicked"
                            Tag="SelectedTabBorderText" />
                    <TextBox x:Name="SelectedTabBorderText"
                             Grid.Column="1"
                             Style="{StaticResource EditorStyle}"
                             LostKeyboardFocus="OnColorTextCommitted"
                             Tag="selectedTabBorderColor" />
                </Grid>
                <TextBlock Grid.Row="11"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Active     Background" />
                <Grid Grid.Row="11"
                      Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ActiveTabBackgroundSwatch"
                            Margin="0,4,4,4"
                            BorderBrush="#777"
                            BorderThickness="1"
                            MouseLeftButtonDown="OnColorSwatchClicked"
                            Tag="ActiveTabBackgroundText" />
                    <TextBox x:Name="ActiveTabBackgroundText"
                             Grid.Column="1"
                             Style="{StaticResource EditorStyle}"
                             LostKeyboardFocus="OnColorTextCommitted"
                             Tag="activeTabBackgroundColor" />
                </Grid>
                <TextBlock Grid.Row="12"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Active     Border" />
                <Grid Grid.Row="12"
                      Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ActiveTabBorderSwatch"
                            Margin="0,4,4,4"
                            BorderBrush="#777"
                            BorderThickness="1"
                            MouseLeftButtonDown="OnColorSwatchClicked"
                            Tag="ActiveTabBorderText" />
                    <TextBox x:Name="ActiveTabBorderText"
                             Grid.Column="1"
                             Style="{StaticResource EditorStyle}"
                             LostKeyboardFocus="OnColorTextCommitted"
                             Tag="activeTabBorderColor" />
                </Grid>
                <Grid Grid.Row="13"
                      Grid.ColumnSpan="2"
                      Margin="0,22,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SubsectionHeaderStyle}"
                               Text="Typography" />
                    <Border Grid.Column="1"
                            Height="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Background="#FF4A4A4A" />
                </Grid>
                <TextBlock Grid.Row="14"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Normal" />
                <Grid Grid.Row="14"
                      Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="59" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TabTextColorSwatch"
                            Margin="0,4,4,4"
                            BorderBrush="#777"
                            BorderThickness="1"
                            MouseLeftButtonDown="OnColorSwatchClicked"
                            Tag="TabTextColorText" />
                    <TextBox x:Name="TabTextColorText"
                             Grid.Column="1"
                             Style="{StaticResource EditorStyle}"
                             LostKeyboardFocus="OnColorTextCommitted"
                             Tag="tabTextColor" />
                    <CheckBox x:Name="TabWeight"
                              Grid.Column="2"
                              Content="Bold"
                              Style="{StaticResource FontOptionCheckBoxStyle}"
                              Checked="OnFontSettingChanged"
                              Unchecked="OnFontSettingChanged"
                              Tag="tabTextBold" />
                    <CheckBox x:Name="TabStyle"
                              Grid.Column="3"
                              Content="Italic"
                              Style="{StaticResource FontOptionCheckBoxStyle}"
                              Checked="OnFontSettingChanged"
                              Unchecked="OnFontSettingChanged"
                              Tag="tabTextItalic" />
                    <TextBox x:Name="TabSize"
                             Grid.Column="4"
                             Style="{StaticResource EditorStyle}"
                             LostKeyboardFocus="OnFontSizeCommitted"
                             Tag="tabTextSize" />
                </Grid>
                <TextBlock Grid.Row="15"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Hovered" />
                <Grid Grid.Row="15"
                      Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="59" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TabHoverTextColorSwatch"
                            Margin="0,4,4,4"
                            BorderBrush="#777"
                            BorderThickness="1"
                            MouseLeftButtonDown="OnColorSwatchClicked"
                            Tag="TabHoverTextColorText" />
                    <TextBox x:Name="TabHoverTextColorText"
                             Grid.Column="1"
                             Style="{StaticResource EditorStyle}"
                             LostKeyboardFocus="OnColorTextCommitted"
                             Tag="tabHoverTextColor" />
                    <CheckBox x:Name="TabHoverWeight"
                              Grid.Column="2"
                              Content="Bold"
                              Style="{StaticResource FontOptionCheckBoxStyle}"
                              Checked="OnFontSettingChanged"
                              Unchecked="OnFontSettingChanged"
                              Tag="tabHoverTextBold" />
                    <CheckBox x:Name="TabHoverStyle"
                              Grid.Column="3"
                              Content="Italic"
                              Style="{StaticResource FontOptionCheckBoxStyle}"
                              Checked="OnFontSettingChanged"
                              Unchecked="OnFontSettingChanged"
                              Tag="tabHoverTextItalic" />
                    <TextBox x:Name="TabHoverSize"
                             Grid.Column="4"
                             Style="{StaticResource EditorStyle}"
                             LostKeyboardFocus="OnFontSizeCommitted"
                             Tag="tabHoverTextSize" />
                </Grid>
                <TextBlock Grid.Row="16"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Selected" />
                <Grid Grid.Row="16"
                      Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="59" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SelectedTabTextColorSwatch"
                            Margin="0,4,4,4"
                            BorderBrush="#777"
                            BorderThickness="1"
                            MouseLeftButtonDown="OnColorSwatchClicked"
                            Tag="SelectedTabTextColorText" />
                    <TextBox x:Name="SelectedTabTextColorText"
                             Grid.Column="1"
                             Style="{StaticResource EditorStyle}"
                             LostKeyboardFocus="OnColorTextCommitted"
                             Tag="selectedTabTextColor" />
                    <CheckBox x:Name="SelectedTabWeight"
                              Grid.Column="2"
                              Content="Bold"
                              Style="{StaticResource FontOptionCheckBoxStyle}"
                              Checked="OnFontSettingChanged"
                              Unchecked="OnFontSettingChanged"
                              Tag="selectedTabTextBold" />
                    <CheckBox x:Name="SelectedTabStyle"
                              Grid.Column="3"
                              Content="Italic"
                              Style="{StaticResource FontOptionCheckBoxStyle}"
                              Checked="OnFontSettingChanged"
                              Unchecked="OnFontSettingChanged"
                              Tag="selectedTabTextItalic" />
                    <TextBox x:Name="SelectedTabSize"
                             Grid.Column="4"
                             Style="{StaticResource EditorStyle}"
                             LostKeyboardFocus="OnFontSizeCommitted"
                             Tag="selectedTabTextSize" />
                </Grid>
                <TextBlock Grid.Row="17"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Active" />
                <Grid Grid.Row="17"
                      Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="59" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ActiveTabTextColorSwatch"
                            Margin="0,4,4,4"
                            BorderBrush="#777"
                            BorderThickness="1"
                            MouseLeftButtonDown="OnColorSwatchClicked"
                            Tag="ActiveTabTextColorText" />
                    <TextBox x:Name="ActiveTabTextColorText"
                             Grid.Column="1"
                             Style="{StaticResource EditorStyle}"
                             LostKeyboardFocus="OnColorTextCommitted"
                             Tag="activeTabTextColor" />
                    <CheckBox x:Name="ActiveTabWeight"
                              Grid.Column="2"
                              Content="Bold"
                              Style="{StaticResource FontOptionCheckBoxStyle}"
                              Checked="OnFontSettingChanged"
                              Unchecked="OnFontSettingChanged"
                              Tag="activeTabTextBold" />
                    <CheckBox x:Name="ActiveTabStyle"
                              Grid.Column="3"
                              Content="Italic"
                              Style="{StaticResource FontOptionCheckBoxStyle}"
                              Checked="OnFontSettingChanged"
                              Unchecked="OnFontSettingChanged"
                              Tag="activeTabTextItalic" />
                    <TextBox x:Name="ActiveTabSize"
                             Grid.Column="4"
                             Style="{StaticResource EditorStyle}"
                             LostKeyboardFocus="OnFontSizeCommitted"
                             Tag="activeTabTextSize" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
