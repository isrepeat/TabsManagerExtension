<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Словарь хранит только геометрию и внешний вид. Условия показа и привязки
         к состоянию конкретных контролов остаются в XAML этих контролов. -->
    <Geometry x:Key="Icons/TabSelectionCheckmarkGeometry">M 1,6.5 L 5.5,11 L 15,1</Geometry>

    <Style x:Key="Icons/TabSelectionCheckmarkStyle" TargetType="Path">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Data" Value="{StaticResource Icons/TabSelectionCheckmarkGeometry}" />
        <Setter Property="Stroke" Value="#FFD4D4D4" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Square" />
        <Setter Property="StrokeEndLineCap" Value="Square" />
        <Setter Property="StrokeLineJoin" Value="Miter" />
        <Setter Property="Stretch" Value="Fill" />
    </Style>

    <!-- Иконки панели управления вкладкой. -->
    <Style x:Key="Icons/CloseTabStyle" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Data" Value="M 3.5,3.5 L 12.5,12.5 M 12.5,3.5 L 3.5,12.5" />
        <Setter Property="StrokeThickness" Value="0.8" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Stretch" Value="None" />
    </Style>

    <Style x:Key="Icons/PinTabStyle" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Data" Value="M 9.5,2.5 L 13.5,6.5 L 11.5,7.5 L 9.5,9.5 L 8.5,12.5 L 3.5,7.5 L 6.5,6.5 L 8.5,4.5 Z M 5.5,10.5 L 2.5,13.5" />
        <Setter Property="StrokeThickness" Value="0.8" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stretch" Value="None" />
    </Style>

    <Style x:Key="Icons/UnpinTabStyle" TargetType="Path" BasedOn="{StaticResource Icons/PinTabStyle}">
    </Style>

    <Style x:Key="Icons/KeepOpenTabStyle" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Data" Value="M 6.5,3.5 L 2.5,7.5 L 6.5,11.5 M 2.5,7.5 L 9.5,7.5 C 12.3,7.5 13.5,9.2 13.5,12.5" />
        <Setter Property="StrokeThickness" Value="0.8" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stretch" Value="None" />
    </Style>

    <!-- Иконки toolbar панели. -->
    <Style x:Key="Icons/TabsEditModeStyle" TargetType="Path">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Data" Value="M 0,1 L 14,1 M 0,5 L 14,5 M 0,9 L 14,9" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeStartLineCap" Value="Square" />
        <Setter Property="StrokeEndLineCap" Value="Square" />
        <Setter Property="Stretch" Value="None" />
    </Style>

    <!-- Два самостоятельных состояния оглавления. Active содержит увеличенный
         маркер текущей секции непосредственно в геометрии, без overlay-элементов. -->
    <Geometry x:Key="Icons/AnchorOutlineNormalGeometry">M 1,3 L 2.5,3 M 5.5,3 L 14,3 M 1,7.5 L 2.5,7.5 M 5.5,7.5 L 14,7.5 M 1,12 L 2.5,12 M 5.5,12 L 14,12</Geometry>
    <!-- Маркер active вписан в тот же диапазон X=1..2.5, что и обычный штрих.
         Благодаря одинаковым bounds Uniform не меняет масштаб иконки между состояниями. -->
    <Geometry x:Key="Icons/AnchorOutlineActiveGeometry">M 1,3 L 2.5,3 M 5.5,3 L 14,3 M 2.5,7.5 A 0.75,0.75 0 1 1 1,7.5 A 0.75,0.75 0 1 1 2.5,7.5 Z M 5.5,7.5 L 14,7.5 M 1,12 L 2.5,12 M 5.5,12 L 14,12</Geometry>

    <Style x:Key="Icons/AnchorOutlineStyle" TargetType="Path">
        <!-- Stretch alignment передаёт Path всю площадь контейнера; сам Uniform
             сохраняет пропорции и центрирует геометрию внутри неё. -->
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Data" Value="{StaticResource Icons/AnchorOutlineNormalGeometry}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Icons/TabsSettingsStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Text" Value="&#xE713;" />
    </Style>

    <Style x:Key="Icons/CascadeMenuStyle" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Data" Value="M 2,3 L 3,3 M 5,3 L 14,3 M 2,8 L 3,8 M 5,8 L 14,8 M 2,13 L 3,13 M 5,13 L 14,13" />
        <Setter Property="StrokeThickness" Value="1.25" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Opacity" Value="0.48" />
    </Style>
</ResourceDictionary>
