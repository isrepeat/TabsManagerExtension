<helpers:BaseUserControl x:Class="TabsManagerExtension.Controls.TabItemControl"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:local="clr-namespace:TabsManagerExtension"
                         xmlns:localControls="clr-namespace:TabsManagerExtension.Controls"
                         xmlns:localBehaviours="clr-namespace:TabsManagerExtension.Behaviours"
                         xmlns:localStateDocument="clr-namespace:TabsManagerExtension.State.Document"
                         xmlns:helpers="clr-namespace:Helpers"
                         x:Name="__TabItemControl"
                         Focusable="{Binding IsEditMode, ElementName=__TabItemControl}"
                         >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/BrushResources.xaml"/>
                <ResourceDictionary Source="../Styles/IconResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SelectableCheckBoxContainerStyle" TargetType="CheckBox">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Background" Value="{DynamicResource AppTabBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTabForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppTabBorderBrush}" />
                <Setter Property="FontWeight" Value="{DynamicResource AppTabFontWeight}" />
                <Setter Property="FontStyle" Value="{DynamicResource AppTabFontStyle}" />
                <Setter Property="FontSize" Value="{DynamicResource AppTabItemFontSize}" />
                <Setter Property="Height" Value="{DynamicResource AppTabItemHeight}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <!-- 
                                Обязательно задаём Background, иначе Padding не ловит клики.
                                Без этого CheckBox не реагирует на нажатия вне текста.
                            -->
                            <Grid Margin="0,0,5,0">
                                <!-- Основная рамка отражает только активный VS-фрейм. -->
                                <Border Padding="5,0,0,0"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        IsHitTestVisible="True">
                                    <ContentPresenter />
                                </Border>
                                <!-- Отдельный overlay не смешивает клавиатурный фокус с активной рамкой. -->
                                <Rectangle x:Name="KeyboardNavigationBorder"
                                           IsHitTestVisible="False"
                                           SnapsToDevicePixels="True"
                                           Stroke="#FF808080"
                                           StrokeThickness="1.2"
                                           StrokeDashArray="3,4"
                                           RadiusX="4"
                                           RadiusY="4"
                                           Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Активный VS-фрейм всегда сохраняет сплошную серую рамку;
                                     пунктир показываем только на другой навигационной вкладке. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEditFocused, ElementName=__TabItemControl}" Value="True" />
                                        <Condition Binding="{Binding Metadata[IsFrameActive]}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="KeyboardNavigationBorder" Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppTabHoverBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AppTabHoverBorderBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppTabHoverForegroundBrush}"/>
                        <Setter Property="FontWeight" Value="{DynamicResource AppTabHoverFontWeight}"/>
                        <Setter Property="FontStyle" Value="{DynamicResource AppTabHoverFontStyle}"/>
                        <Setter Property="FontSize" Value="{DynamicResource AppTabHoverFontSize}"/>
                    </Trigger>

                    <DataTrigger Binding="{Binding IsPinnedTab}" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppTabSelectedBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AppTabSelectedBorderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource AppTabSelectedForegroundBrush}" />
                        <Setter Property="FontWeight" Value="{DynamicResource AppTabSelectedFontWeight}" />
                        <Setter Property="FontStyle" Value="{DynamicResource AppTabSelectedFontStyle}" />
                        <Setter Property="FontSize" Value="{DynamicResource AppTabSelectedFontSize}" />
                    </DataTrigger>

                    <!-- Открытый VS-фрейм оформляется как стандартная вкладка: нейтральная
                         сплошная рамка и слегка приподнятый относительно панели фон. -->
                    <DataTrigger Binding="{Binding Metadata[IsFrameActive]}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppTabActiveBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AppTabActiveBorderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource AppTabActiveForegroundBrush}" />
                        <Setter Property="FontWeight" Value="{DynamicResource AppTabActiveFontWeight}" />
                        <Setter Property="FontStyle" Value="{DynamicResource AppTabActiveFontStyle}" />
                        <Setter Property="FontSize" Value="{DynamicResource AppTabActiveFontSize}" />
                    </DataTrigger>

                    <!-- Для неактивной навигационной вкладки основную рамку скрывает пунктирный
                         overlay. Активная вкладка продолжает использовать сплошную рамку выше. -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsEditFocused, ElementName=__TabItemControl}" Value="True" />
                            <Condition Binding="{Binding Metadata[IsFrameActive]}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="Transparent" />
                    </MultiDataTrigger>

                    <!-- Во время inline rename hover не должен подсвечивать контейнер вкладки:
                         визуально активным элементом теперь является само поле ввода. -->
                    <DataTrigger Binding="{Binding IsRenaming, ElementName=__TabItemControl}" Value="True">
                        <Setter Property="Background" Value="Transparent" />
                    </DataTrigger>

                </Style.Triggers>
            </Style>


            <Style x:Key="ControlPanelStyle" TargetType="Grid">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsPinnedTab}" Value="False"/>
                            <Condition Binding="{Binding IsMouseInside, ElementName=__TabItemControl}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </MultiDataTrigger>
                    <!-- Rename занимает всю строку заголовка, поэтому временно скрываем
                         pin/keep-open/close независимо от pinned и preview-состояния. -->
                    <DataTrigger Binding="{Binding IsRenaming, ElementName=__TabItemControl}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>


            <Style x:Key="ControlPanelPrimarySlotTemplateStyle" TargetType="ContentPresenter">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsPinnedTab}" Value="True"/>
                            <Condition Binding="{Binding IsMouseInside, ElementName=__TabItemControl}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Hidden" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>


    <Grid>
        <CheckBox x:Name="TabContainer"
                  Style="{StaticResource SelectableCheckBoxContainerStyle}"
                  IsChecked="{Binding IsSelected, ElementName=__TabItemControl, Mode=TwoWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Галочка. В обычном режиме контейнер схлопнут и не занимает место перед заголовком. -->
                <Grid Grid.Column="0"
                      Width="16">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode, ElementName=__TabItemControl}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Path>
                        <Path.Style>
                            <!-- Внешний вид приходит из общего словаря, а условия показа остаются рядом с контекстом TabItemControl. -->
                            <Style TargetType="Path" BasedOn="{StaticResource Icons/TabSelectionCheckmarkStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSelected, ElementName=__TabItemControl}" Value="True" />
                                            <Condition Binding="{Binding IsMultipleSelection, ElementName=__TabItemControl}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>

                <Grid Grid.Column="1" Margin="5,0,5,0">
                    <TextBlock
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Title, ElementName=__TabItemControl}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRenaming, ElementName=__TabItemControl}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="RenameTextBox"
                             MinWidth="80"
                             Margin="0,1"
                             Padding="3,0"
                             FontSize="{DynamicResource AppTabItemFontSize}"
                             VerticalContentAlignment="Center"
                             Text="{Binding RenameText, ElementName=__TabItemControl, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="RenameTextBox_OnKeyDown"
                             LostKeyboardFocus="RenameTextBox_OnLostKeyboardFocus">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <!-- Нейтральное inline-поле в стиле тёмной темы VS: оно остаётся частью
                                     строки вкладки и не выглядит ярким системным TextBox. -->
                                <Setter Property="Background" Value="#FF252526" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                                <Setter Property="CaretBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                                <Setter Property="BorderBrush" Value="#FF6B6B6B" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="SelectionBrush" Value="#FF0078D7" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRenaming, ElementName=__TabItemControl}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
                <Grid Style="{StaticResource ControlPanelStyle}"
                      Grid.Column="2"
                      HorizontalAlignment="Right"
                      >
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter Content="{Binding}" 
                                          ContentTemplate="{Binding ControlPanelSecondarySlotTemplate, ElementName=__TabItemControl}"
                                          />
                        <ContentPresenter Style="{StaticResource ControlPanelPrimarySlotTemplateStyle}"
                                          Content="{Binding}" 
                                          ContentTemplate="{Binding ControlPanelPrimarySlotTemplate, ElementName=__TabItemControl}"
                                          />
                    </StackPanel>
                </Grid>
            </Grid>
        </CheckBox>

        <!-- Контекстное меню -->
        <ContentPresenter x:Name="ContextMenuContentPresenter"
                          Content="{Binding}" 
                          ContentTemplate="{Binding ContextMenuTemplate, ElementName=__TabItemControl}"
                          />
    </Grid>
</helpers:BaseUserControl>
