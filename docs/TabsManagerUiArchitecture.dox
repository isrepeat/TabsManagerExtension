    source [label="DTE WindowActivated /\nIVsWindowFrameActivated"];
    pending [label="pending tool-window restore?", shape=diamond, fillcolor="#51421f"];
    lookup [label="find/create TabItem"];
    frame [label="SetActiveFrame"];
    select [label="SelectActivated"];
    overlay [label="show/activate editor overlay\nor hide for tool window"];

    source -> pending;
    pending -> lookup [label="no"];
    pending -> overlay [label="yes: keep pending frame", style=dashed];
    lookup -> frame -> select -> overlay;
}
@enddot

@section tabs_ui_close_flow Поток закрытия и восстановления

@dot
digraph TabCloseFlow {
    graph [rankdir=LR, bgcolor="#1b1f26", fontname="Segoe UI", fontcolor="#f1f5f9"];
    node [shape=box, style="rounded,filled", fillcolor="#273142", color="#718096", fontcolor="#f1f5f9", fontname="Segoe UI", fontsize=9];
    edge [color="#8aa4c2", fontcolor="#d9e2ec", fontname="Segoe UI", fontsize=8];

    command [label="TabCommandController.Close"];
    snapshot [label="snapshot group + metadata\nmark whole batch"];
    dte [label="DTE Document.Close"];
    event [label="TabsWorkspaceSynchronizer\nDocumentClosing"];
    remove [label="TabCollectionManager.Remove"];
    history [label="ClosedTabsHistory\nsingle undo operation"];
    restore [label="ClosedTabsRestorer\nopen + return to group"];

    command -> snapshot -> dte -> event -> remove;
    snapshot -> history [label="after confirmed close"];
    event -> history [label="external close"];
    history -> restore [label="Ctrl+Z"];
    restore -> remove [label="collection update", style=dashed];
}
@enddot

@section tabs_ui_lifecycle Жизненный цикл control

- `Loaded`: создаётся event bridge, file monitor, collection/selection stack,
  контроллеры и periodic reconciler; затем загружается снимок открытых
  документов и tool window.
- Во время работы event bridge и file monitor только адаптируют внешние
  события; решения принимают workspace/activation/command controllers.
- `Unloaded`: сохраняется сессия, отменяется pending restore, отписываются
  события, останавливаются timers/file monitor и освобождаются VS-ресурсы.
*/
